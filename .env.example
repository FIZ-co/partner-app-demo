# Copy to .env. Never commit .env or paste secrets into browser code.
# Use the SAME app name in FIZ Settings → Integrations → Developer apps.
APP_NAME="Acme Orders"
PORT=3100
# Optional; defaults to http://localhost:PORT. Update all registered URLs if changed.
# DEMO_BASE_URL=http://localhost:3100

# Three distinct values from your registered FIZ Development application.
# Missing credentials show the local integration setup page; no fake FIZ is started.
FIZ_APP_ID=
FIZ_CLIENT_ID=
FIZ_CLIENT_SECRET=

# Default connection is REAL production FIZ, with real company records.
# Development app access is limited to the creator and configured testers.
# Overrides are only needed when developing against a different FIZ deployment:
# FIZ_APP_URL=https://app.fiz.co
# FIZ_OAUTH_ISSUER=https://api.fiz.co
# FIZ_API_URL=https://api.fiz.co
# FIZ_OAUTH_RESOURCE=https://api.fiz.co
